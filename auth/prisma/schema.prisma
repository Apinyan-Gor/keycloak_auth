// Prisma schema. Provider is inferred from DATABASE_URL at runtime when pushing.
generator client {
  provider = "sqlite"
}

datasource db {
  // Default provider is sqlite. A helper script will replace this line automatically
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
}
